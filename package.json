{
  "name": "cape-monitor",
  "version": "1.0.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4173",
    "data": "python3 -I pipeline/catalogue.py && python3 -I pipeline/fetch_city.py && python3 -I pipeline/fetch_extra.py && python3 -I pipeline/build.py",
    "data:refresh": "python3 -I pipeline/catalogue.py && python3 -I pipeline/fetch_city.py --refresh && python3 -I pipeline/fetch_extra.py --refresh && python3 -I pipeline/build.py",
    "vendor": "node -e \"require('fs').mkdirSync('public/vendor',{recursive:true});for (const f of ['maplibre-gl-worker.mjs','maplibre-gl-shared.mjs']) require('fs').copyFileSync('node_modules/maplibre-gl/dist/'+f, 'public/vendor/'+f)\"",
    "predev": "npm run vendor",
    "prebuild": "npm run vendor",
    "metro": "python3 -I pipeline/metro/run.py full",
    "test": "playwright test --trace off"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.2",
    "@playwright/test": "^1.65.1",
    "@types/geojson": "^7946.0.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "geojson-vt": "^5.0.4",
    "maplibre-gl": "^6.19.0",
    "pmtiles": "^4.5.0",
    "vt-pbf": "^3.1.3"
  },
  "private": true,
  "type": "module"
}